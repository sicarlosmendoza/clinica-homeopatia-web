generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// 1. MODELO DE USUARIOS (MÉDICOS/ADMINISTRADORES)
// ------------------------------------------------------------------
model Usuario {
  id            String    @id @default(uuid()) @db.Uuid
  nombre        String?   @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime? @db.Timestamp()
  image         String?   @db.Text
  rol           String    @default("USER") @db.VarChar(50)
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamp()
  updatedAt     DateTime  @updatedAt @db.Timestamp()

  @@map("usuarios")
}

// ------------------------------------------------------------------
// 2. MODELO DE PACIENTES (DATOS GENERALES)
// ------------------------------------------------------------------
model Paciente {
  id                 String   @id @default(uuid()) @db.Uuid
  folio              String   @unique @db.VarChar(20)
  nombre_completo    String   @db.VarChar(255)
  fecha_nacimiento   DateTime @db.Date
  sexo               String?  @db.VarChar(20)
  foto               String?  @db.Text
  genero             String?  @db.VarChar(50)
  escolaridad        String?  @db.VarChar(100)
  ocupacion          String?  @db.VarChar(150)
  estado_civil       String?  @db.VarChar(50)
  telefono           String?  @db.VarChar(20)
  correo_electronico String?  @db.VarChar(100)
  fecha_registro     DateTime @default(now()) @db.Timestamp()

  historia_clinica   HistoriaClinica?
  consultas          Consulta[]
  archivos           Archivo[]
  citas              Cita[]
  

  @@map("pacientes")
}

// ------------------------------------------------------------------
// 3. MODELO: HISTORIA CLÍNICA (Apertura - 1 por paciente)
// ------------------------------------------------------------------
model HistoriaClinica {
  id                       String   @id @default(uuid()) @db.Uuid
  paciente_id              String   @unique @db.Uuid
  paciente                 Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)

  // 3.1 BLOQUE UNIVERSAL
  ahf                      String?  @db.Text // Antecedentes Heredofamiliares
  apnp                     String?  @db.Text // Antecedentes Personales No Patológicos
  app                      String?  @db.Text // Antecedentes Personales Patológicos
  diagnostico_psiquiatrico String?  @db.Text 
  enfermedades_venereas    String?  @db.Text 
  sensibilidad_termica     String?  @db.VarChar(100) // Friolento, Caluroso
  sed                      String?  @db.VarChar(150)
  deseos_aversiones        String?  @db.Text

  // 3.2 BLOQUE GINECO-OBSTÉTRICO (Mujeres)
  menarca                  Int?     
  ritmo_menstrual          String?  @db.VarChar(100) 
  fum                      DateTime? @db.Date 
  gestas                   Int?     @default(0)
  partos                   Int?     @default(0)
  cesareas                 Int?     @default(0)
  abortos                  Int?     @default(0)
  metodo_anticonceptivo    String?  @db.VarChar(150)

  // 3.3 BLOQUE PERINATAL Y LACTANCIA (0 a 23 meses)
  tipo_nacimiento          String?  @db.VarChar(100) 
  apgar                    String?  @db.VarChar(50)
  peso_nacer               Decimal? @db.Decimal(5, 2) 
  talla_nacer              Decimal? @db.Decimal(5, 2) 
  lactancia                String?  @db.VarChar(150)
  desarrollo_psicomotor    String?  @db.Text
  vacunas                  String?  @db.Text

  // 3.4 BLOQUE INFANTIL / ESCOLAR (2 a 11 años)
  edad_caminar             String?  @db.VarChar(50)
  desarrollo_lenguaje      String?  @db.VarChar(150)
  control_esfinteres       String?  @db.VarChar(150)
  patron_sueno             String?  @db.Text
  comportamiento           String?  @db.Text
  miedos_especificos       String?  @db.Text
  rendimiento_escolar      String?  @db.Text

  // 3.5 BLOQUE HÁBITOS ADULTOS / ADOLESCENTES (+12 años)
  tabaquismo               String?  @db.VarChar(150)
  alcoholismo              String?  @db.VarChar(150)
  cafeina_estimulantes     String?  @db.VarChar(150)
  alimentacion             String?  @db.Text
  actividad_fisica         String?  @db.VarChar(150)
  estado_animo             String?  @db.Text
  nivel_estres             String?  @db.VarChar(100)

  fecha_actualizacion      DateTime @updatedAt @db.Timestamp()

  @@map("historias_clinicas")
}

// ------------------------------------------------------------------
// 4. MODELO: CONSULTAS (El día a día - N por paciente)
// ------------------------------------------------------------------
model Consulta {
  id                    String   @id @default(uuid()) @db.Uuid
  paciente_id           String   @db.Uuid
  
  folio_consulta        String   @unique @db.VarChar(50) 
  numero_consulta       Int      @default(1)
  fecha_consulta        DateTime @default(now()) @db.Timestamp()
  origen                String   @default("PRESENCIAL") @db.VarChar(50)
  
  peso                  Decimal? @db.Decimal(5,2) 
  talla                 Decimal? @db.Decimal(5,2) 
  presion_arterial      String?  @db.VarChar(20)  
  frecuencia_cardiaca   Int?     
  frecuencia_resp       Int?     
  temperatura           Decimal? @db.Decimal(4,2) 
  saturacion_oxigeno    Int?     

  motivo_consulta       String   @db.Text
  desde_cuando          String?  @db.VarChar(255)
  caso_clinico          String?  @db.Text 
  sintomas_mentales     String?  @db.Text
  sintomas_generales    String?  @db.Text
  sintomas_particulares String?  @db.Text
  
  tipo_paciente         String?  @db.VarChar(100)
  miasma_predisponente  String?  @db.VarChar(100)
  miasma_secundario     String?  @db.VarChar(100)
  tipo_caso             String?  @db.VarChar(100)
  nivel_salud           String?  @db.VarChar(100)
  
  intencion             String?  @db.VarChar(255)
  sugerencias           String?  @db.Text
  
  creado_en             DateTime @default(now()) @db.Timestamp()
  actualizado_en        DateTime @updatedAt

  paciente              Paciente      @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  medico_id             String?       @db.Uuid
  medico                Medico?       @relation(fields: [medico_id], references: [id])
  archivos              Archivo[] 
  tratamientos          Tratamiento[]

  @@map("consultas")
}

// ------------------------------------------------------------------
// 5. NUEVA TABLA PARA RECETAS MÚLTIPLES
// ------------------------------------------------------------------
model Tratamiento {
  id                String   @id @default(uuid()) @db.Uuid
  consulta_id       String   @db.Uuid
  medicamento       String   @db.VarChar(255)
  escala_potencia   String?  @db.VarChar(100)
  cantidad_sucusion String?  @db.VarChar(100)
  frecuencia        String?  @db.VarChar(100)
  duracion          String?  @db.VarChar(100)

  consulta          Consulta @relation(fields: [consulta_id], references: [id], onDelete: Cascade)

  @@map("tratamientos")
}

// ------------------------------------------------------------------
// 6. MODELO DE ARCHIVOS ADJUNTOS
// ------------------------------------------------------------------
model Archivo {
  id          String    @id @default(uuid()) @db.Uuid
  paciente_id String    @db.Uuid
  paciente    Paciente  @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  
  consulta_id String?   @db.Uuid
  consulta    Consulta? @relation(fields: [consulta_id], references: [id], onDelete: SetNull)

  nombre      String    @db.VarChar(255)
  descripcion String?   @db.Text
  url         String    @db.Text
  tipo        String    @db.VarChar(50)
  origen      String    @default("HISTORIA_INICIAL")
  creado_en   DateTime  @default(now())

  @@index([paciente_id])
}

// ==========================================
// MÓDULO DE AGENDA Y CITAS (FASE 3)
// ==========================================

model Sede {
  id              String    @id @default(uuid()) @db.Uuid
  nombre          String
  direccion       String?
  telefono        String?
  color           String?
  
  // --- NUEVOS CAMPOS PÚBLICOS ---
  descripcion     String?   @db.Text
  imagen_url      String?   // URL de Vercel Blob para la foto de la fachada/consultorio
  link_maps       String?   // URL de Google Maps
  
  activo          Boolean   @default(true)
  
  citas           Cita[]
  horarios_medico HorarioMedico[]
}

// NUEVO: Catálogo de Médicos (Permite escalar a más doctores en el futuro)
model Medico {
  id              String    @id @default(uuid()) @db.Uuid
  nombre          String    // Ej: "Dra. Arizai"
  especialidad    String?   @default("Médico Homeópata")
  activo          Boolean   @default(true)
  cedula          String?  @db.VarChar(50)
  horarios        HorarioMedico[]
  citas           Cita[]
  consultas       Consulta[]
}

// NUEVO: Horarios cruzados (Evita que un médico esté en dos sedes al mismo tiempo)
model HorarioMedico {
  id              String    @id @default(uuid()) @db.Uuid
  
  medico_id       String    @db.Uuid
  medico          Medico    @relation(fields: [medico_id], references: [id])
  
  sede_id         String    @db.Uuid
  sede            Sede      @relation(fields: [sede_id], references: [id])
  
  dia_semana      Int       // 1 = Lunes, 2 = Martes, 3 = Miércoles... 7 = Domingo
  hora_inicio     String    // Ej: "09:00"
  hora_fin        String    // Ej: "14:00"
  
  activo          Boolean   @default(true)
}

model Cita {
  id              String    @id @default(uuid()) @db.Uuid
  
  // Relaciones
  sede_id         String    @db.Uuid
  sede            Sede      @relation(fields: [sede_id], references: [id])
  
  medico_id       String?   @db.Uuid  // NUEVO: Saber qué doctor atiende la cita
  medico          Medico?   @relation(fields: [medico_id], references: [id])
  
  paciente_id     String?   @db.Uuid
  paciente        Paciente? @relation(fields: [paciente_id], references: [id])
  
  // Datos del paciente
  nombre_paciente String    
  telefono        String?
  correo          String?
  
  // Datos de la cita
  fecha_cita      DateTime  
  motivo          String?   
  estado          String    @default("PENDIENTE") 
  
  creado_en       DateTime  @default(now())
  actualizado_en  DateTime  @updatedAt
}
